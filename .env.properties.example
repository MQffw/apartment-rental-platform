# ============================================================
# 本地密钥模板：复制本文件为 .env.properties 并填入真实值
# （.env.properties 已被 .gitignore 排除，不会进入仓库）
# 机制：两个 web 模块的 application.yml 通过 spring.config.import
#       读取仓库根目录的 .env.properties
# ============================================================

# MySQL 密码（必填，无默认值）
DB_PASSWORD=

# RabbitMQ 密码（必填，无默认值；用户名默认 admin）
RABBITMQ_PASS=

# SMTP 发件邮箱与授权码（web-app 邮箱验证码；QQ 邮箱为授权码而非登录密码）
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- 以下可选（dev profile 有安全的兜底值）----
# MinIO（默认 minioadmin）
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# JWT 密钥（dev 使用占位假密钥；生成强密钥：openssl rand -base64 48）
# JWT_SECRET=
